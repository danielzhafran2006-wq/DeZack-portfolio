---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "DeZack | Software Engineer & Freelance Web Developer",
  description = "High-performance full-stack web applications, custom websites, and backend APIs crafted for modern businesses.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Social Sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </head>
  <body class="flex min-h-screen flex-col bg-slate-950 text-slate-100">
    <slot />
  </body>
</html>
