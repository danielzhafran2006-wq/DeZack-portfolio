---
const testimonials = [
  {
    quote: "Delivered our complete web application ahead of schedule with exceptional attention to UX and performance. Communication was clear from day one.",
    author: "Sarah M.",
    role: "Founder, Fintech Studio",
  },
  {
    quote: "Rebuilt our slow website into a super-fast platform. Our organic search traffic and inquiry form conversions doubled within 30 days.",
    author: "David K.",
    role: "Managing Director, Advisory Group",
  },
];
---

<section id="testimonials" class="py-20 border-t border-slate-900 bg-slate-950">
  <div class="max-w-5xl mx-auto px-6">
    <div class="text-center max-w-xl mx-auto mb-16">
      <h2 class="text-xs font-bold uppercase tracking-wider text-teal-400 mb-3">Client Trust</h2>
      <h3 class="text-3xl font-extrabold text-white">What founders & collaborators say</h3>
    </div>

    <div class="grid md:grid-cols-2 gap-8">
      {testimonials.map((t) => (
        <div class="p-8 rounded-2xl bg-slate-900/40 border border-slate-800/80 relative">
          <span class="text-4xl text-teal-500/20 font-serif leading-none absolute top-6 left-6">“</span>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-6 pt-4 relative z-10 italic">
            "{t.quote}"
          </p>
          <div class="pt-4 border-t border-slate-800/80">
            <p class="font-bold text-white text-sm">{t.author}</p>
            <p class="text-xs text-teal-400 mt-0.5">{t.role}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
