---
// Free zero-backend form endpoint powered by Web3Forms.
// Get a free key from https://web3forms.com
---

<section id="contact" class="py-20 border-t border-slate-900 bg-slate-950/70">
  <div class="max-w-3xl mx-auto px-6">
    <div class="text-center mb-12">
      <h2 class="text-xs font-bold uppercase tracking-wider text-teal-400 mb-3">Let's Connect</h2>
      <h3 class="text-3xl font-extrabold text-white mb-4">Have an upcoming project or idea?</h3>
      <p class="text-sm text-slate-400 max-w-lg mx-auto">
        Drop a message below with a few details about what you are building. I typically respond within 24 hours.
      </p>
    </div>

    <div class="p-8 sm:p-10 rounded-2xl bg-slate-900 border border-slate-800 shadow-xl">
      <!-- Web3Forms Zero-Backend Form Endpoint -->
      <form action="https://api.web3forms.com/submit" method="POST" class="space-y-6">
        <!-- Replace YOUR_ACCESS_KEY with the free key from web3forms.com -->
        <input type="hidden" name="access_key" value="YOUR_ACCESS_KEY_HERE" />
        <input type="hidden" name="subject" value="New Client Inquiry for DeZack" />
        <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

        <div class="grid sm:grid-cols-2 gap-6">
          <div>
            <label for="name" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
              Your Name
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="e.g. Alex Smith"
              class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-teal-400 transition-colors"
            />
          </div>
          <div>
            <label for="email" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
              Email Address
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="alex@company.com"
              class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-teal-400 transition-colors"
            />
          </div>
        </div>

        <div>
          <label for="service" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
            Interested Service
          </label>
          <select
            id="service"
            name="service"
            class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white text-sm focus:outline-none focus:border-teal-400 transition-colors"
          >
            <option value="custom-website">Custom Website Development</option>
            <option value="web-application">Full-Stack Web Application</option>
            <option value="backend-api">API & Backend Architecture</option>
            <option value="consulting">Technical Consulting / Other</option>
          </select>
        </div>

        <div>
          <label for="message" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
            Project Overview
          </label>
          <textarea
            id="message"
            name="message"
            rows="4"
            required
            placeholder="Tell me about your timeline, goals, and what you need built..."
            class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-teal-400 transition-colors"
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full py-4 rounded-xl font-bold text-slate-950 bg-teal-400 hover:bg-teal-300 transition-all shadow-lg shadow-teal-500/20 text-sm tracking-wide"
        >
          Send Message
        </button>
      </form>
    </div>
  </div>
</section>
