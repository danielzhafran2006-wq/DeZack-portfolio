---
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto py-12 border-t border-slate-900 bg-slate-950 text-slate-400 text-xs">
  <div class="max-w-6xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-6">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-teal-400"></span>
      <span class="font-semibold text-white">DeZack</span>
      <span>— Built with Astro & Tailwind CSS</span>
    </div>

    <div class="flex items-center gap-6">
      <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="hover:text-teal-400 transition-colors">GitHub</a>
      <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="hover:text-teal-400 transition-colors">LinkedIn</a>
      <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" class="hover:text-teal-400 transition-colors">Twitter</a>
    </div>

    <p>© {currentYear} DeZack. All rights reserved.</p>
  </div>
</footer>
