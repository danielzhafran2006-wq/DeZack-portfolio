---
const projects = [
  {
    title: 'SaaS Analytics Dashboard',
    category: 'Full-Stack Application',
    description: 'Real-time metrics visualization with user role management and Stripe subscription billing.',
    tags: ['TypeScript', 'Astro / React', 'Tailwind CSS', 'Stripe'],
    link: '#',
  },
  {
    title: 'E-Commerce Showcase Platform',
    category: 'Web Design & Storefront',
    description: 'High-speed headless storefront delivering a 98+ Google Lighthouse performance rating.',
    tags: ['Astro', 'Serverless APIs', 'Tailwind', 'SEO Optimization'],
    link: '#',
  },
  {
    title: 'Client Workflow Automation Portal',
    category: 'Internal Tools & APIs',
    description: 'Integrated CRM webhooks and automated client onboarding pipelines, cutting manual overhead by 70%.',
    tags: ['Node.js', 'REST APIs', 'Webhooks', 'Cloud Functions'],
    link: '#',
  },
];
---

<section id="portfolio" class="py-20 border-t border-slate-900 bg-slate-950/50">
  <div class="max-w-6xl mx-auto px-6">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-4">
      <div>
        <h2 class="text-xs font-bold uppercase tracking-wider text-teal-400 mb-3">Featured Work</h2>
        <h3 class="text-3xl font-extrabold text-white">Selected client projects & case studies</h3>
      </div>
      <p class="text-sm text-slate-400 max-w-sm">
        Every project is crafted for real business outcomes: speed, reliability, and measurable conversions.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {projects.map((item) => (
        <div class="rounded-2xl bg-slate-900 border border-slate-800 overflow-hidden hover:border-slate-700 transition-all flex flex-col justify-between">
          <div class="p-6">
            <span class="text-xs font-semibold text-teal-400 uppercase tracking-wider">{item.category}</span>
            <h4 class="text-xl font-bold text-white mt-2 mb-3">{item.title}</h4>
            <p class="text-sm text-slate-300 leading-relaxed mb-6">{item.description}</p>
          </div>

          <div class="px-6 pb-6 pt-2 border-t border-slate-800/60">
            <div class="flex flex-wrap gap-2 mb-4">
              {item.tags.map((tag) => (
                <span class="px-2.5 py-1 rounded-md text-xs font-medium bg-slate-800/80 text-slate-300">
                  {tag}
                </span>
              ))}
            </div>
            <a href={item.link} class="inline-flex items-center gap-1.5 text-xs font-bold text-teal-400 hover:text-teal-300 transition-colors">
              <span>View Case Details</span>
              <span>→</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
