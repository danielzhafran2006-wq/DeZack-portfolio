---
const services = [
  {
    title: 'Custom Website Development',
    description: 'Bespoke marketing sites, portfolio hubs, and landing pages optimized for maximum conversion and ultra-fast SEO scores.',
    deliverables: ['Responsive design', 'Sub-second load times', 'SEO & Analytics ready', 'CMS integration'],
    icon: '⚡',
  },
  {
    title: 'Full-Stack Web Applications',
    description: 'Production-ready web apps with clean architecture, interactive dashboards, user authentication, and third-party APIs.',
    deliverables: ['Database design', 'API integrations', 'Secure auth flows', 'Clean codebase'],
    icon: '🛠️',
  },
  {
    title: 'API & Backend Engineering',
    description: 'Robust serverless functions, RESTful APIs, and webhook automations connecting your tools and business workflows.',
    deliverables: ['Payment gateways (Stripe)', 'Third-party integrations', 'High availability', 'Automated workflows'],
    icon: '🔌',
  },
];
---

<section id="services" class="py-20 border-t border-slate-900 bg-slate-950">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <h2 class="text-xs font-bold uppercase tracking-wider text-teal-400 mb-3">What I Offer</h2>
      <h3 class="text-3xl font-extrabold text-white">Engineering services tailored for high-growth businesses</h3>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {services.map((service) => (
        <div class="p-8 rounded-2xl bg-slate-900/60 border border-slate-800 hover:border-teal-500/40 transition-all flex flex-col justify-between group">
          <div>
            <div class="w-12 h-12 rounded-xl bg-teal-950/60 border border-teal-500/20 text-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
              {service.icon}
            </div>
            <h4 class="text-xl font-bold text-white mb-3">{service.title}</h4>
            <p class="text-sm text-slate-300 leading-relaxed mb-6">{service.description}</p>
          </div>

          <ul class="space-y-2.5 pt-6 border-t border-slate-800/80 text-xs text-slate-400">
            {service.deliverables.map((item) => (
              <li class="flex items-center gap-2">
                <span class="text-teal-400 font-bold">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
