---
---

<section class="relative pt-24 pb-20 md:pt-32 md:pb-28 overflow-hidden">
  <!-- Subtle glowing background gradient -->
  <div class="absolute -top-20 left-1/2 -translate-x-1/2 w-[600px] h-[350px] bg-teal-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-4xl mx-auto px-6 text-center relative z-10">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-medium border border-teal-500/30 bg-teal-950/40 text-teal-300 mb-6">
      <span class="inline-block w-2 h-2 rounded-full bg-teal-400"></span>
      Available for freelance contracts & MVP builds
    </div>

    <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white mb-6 leading-tight">
      Hi, I'm <span class="bg-gradient-to-r from-teal-400 to-emerald-400 bg-clip-text text-transparent">DeZack</span>. I build modern websites & web apps.
    </h1>

    <p class="text-lg sm:text-xl text-slate-300 mb-10 max-w-2xl mx-auto leading-relaxed">
      Helping founders, businesses, and startups transform ideas into responsive, production-ready software with clean architecture and zero fluff.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="#contact"
        class="w-full sm:w-auto px-8 py-3.5 rounded-xl font-semibold text-slate-950 bg-teal-400 hover:bg-teal-300 transition-all shadow-lg shadow-teal-500/20"
      >
        Start a Project
      </a>
      <a
        href="#portfolio"
        class="w-full sm:w-auto px-8 py-3.5 rounded-xl font-semibold text-slate-200 bg-slate-900 border border-slate-800 hover:border-slate-700 hover:text-white transition-all"
      >
        View Case Studies
      </a>
    </div>

    <!-- Quick stats / trust signals -->
    <div class="grid grid-cols-3 gap-6 pt-16 border-t border-slate-800/80 mt-16 max-w-2xl mx-auto">
      <div>
        <p class="text-2xl sm:text-3xl font-extrabold text-white">100%</p>
        <p class="text-xs sm:text-sm text-slate-400 mt-1">Lighthouse Speed</p>
      </div>
      <div>
        <p class="text-2xl sm:text-3xl font-extrabold text-white">&lt;2 Weeks</p>
        <p class="text-xs sm:text-sm text-slate-400 mt-1">Average Delivery</p>
      </div>
      <div>
        <p class="text-2xl sm:text-3xl font-extrabold text-white">Direct</p>
        <p class="text-xs sm:text-sm text-slate-400 mt-1">Engineer Access</p>
      </div>
    </div>
  </div>
</section>
