---
const links = [
  { href: '#services', label: 'Services' },
  { href: '#portfolio', label: 'Projects' },
  { href: '#testimonials', label: 'Testimonials' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-slate-950/80 border-b border-slate-800/80">
  <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="#" class="font-bold text-lg tracking-tight text-white flex items-center gap-2">
      <span class="w-2.5 h-2.5 rounded-full bg-teal-400 animate-pulse"></span>
      <span>DeZack<span class="text-teal-400">.dev</span></span>
    </a>

    <!-- Desktop Menu -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300">
      {links.map((link) => (
        <a href={link.href} class="hover:text-teal-400 transition-colors">
          {link.label}
        </a>
      ))}
      <a
        href="#contact"
        class="px-4 py-2 text-xs font-semibold uppercase tracking-wider text-slate-950 bg-teal-400 hover:bg-teal-300 rounded-full transition-all shadow-sm"
      >
        Hire Me
      </a>
    </nav>

    <!-- Mobile Button -->
    <a
      href="#contact"
      class="md:hidden px-3 py-1.5 text-xs font-medium text-slate-950 bg-teal-400 rounded-full"
    >
      Hire Me
    </a>
  </div>
</header>
